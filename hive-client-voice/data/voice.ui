<?xml version="1.0" encoding="UTF-8"?>
<!-- Voice session — GTK port of hive-android activity_voice.xml:
     SphereView full-bleed; header floats top; buttons float bottom. -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="voiceWindow">
    <property name="title">Voice</property>
    <property name="default-width">440</property>
    <property name="default-height">700</property>
    <property name="resizable">True</property>
    <child>
      <object class="GtkOverlay">
        <child>
          <object class="GtkGLArea" id="sphere">
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <property name="valign">start</property>
            <property name="margin-top">24</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="halign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkImage" id="agentAvatar">
                    <property name="pixel-size">40</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="agentName">
                    <property name="label">Agent</property>
                    <property name="valign">center</property>
                    <style><class name="hv-agent-name"/></style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="statusText">
                <property name="label">Connecting…</property>
                <property name="wrap">True</property>
                <property name="justify">center</property>
                <property name="max-width-chars">42</property>
                <style><class name="hv-status"/></style>
              </object>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="halign">center</property>
            <property name="valign">end</property>
            <property name="margin-bottom">48</property>
            <property name="spacing">28</property>
            <child>
              <object class="GtkButton" id="cancelButton">
                <property name="label">✕</property>
                <property name="valign">center</property>
                <style><class name="hv-cancel"/></style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="talkButton">
                <property name="label">TALK</property>
                <property name="valign">center</property>
                <style><class name="hv-talk"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
