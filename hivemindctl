#!/usr/bin/env bash
# hivemindctl — HiveMind 2.0 control script (Plan.md Phase 8).
# Usage: hivemindctl {build|start|stop|restart|status|logs|client|test}
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

PORT="${HIVEMIND_PORT:-8421}"
SERVER=build/hive-server/hive-server
CLIENT=build/hive-client/hive-client
LOG=/tmp/hivemind-server.log
PIDFILE=/tmp/hivemind-server.pid

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-}" in
  build)
    cmake -S . -B build
    cmake --build build -j"$(nproc)"
    ;;
  start)
    if is_running; then echo "already running (pid $(cat "$PIDFILE"))"; exit 0; fi
    [ -x "$SERVER" ] || { echo "not built — run: hivemindctl build"; exit 1; }
    nohup "$SERVER" --port "$PORT" > "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null \
      && echo "hive-server up on :$PORT (pid $(cat "$PIDFILE"))" \
      || { echo "failed to start — see $LOG"; exit 1; }
    ;;
  stop)
    # SIGTERM so agents persist conversation history on the way out.
    is_running && kill "$(cat "$PIDFILE")" && rm -f "$PIDFILE" && echo "stopped" \
      || echo "not running"
    ;;
  restart) "$0" stop || true; sleep 1; "$0" start ;;
  status)
    if is_running; then
      echo "running (pid $(cat "$PIDFILE"))"
      curl -s "http://127.0.0.1:$PORT/api/health"; echo
      curl -s "http://127.0.0.1:$PORT/api/agents" | head -c 400; echo
    else
      echo "not running"
    fi
    ;;
  logs)   tail -f "$LOG" ;;
  client) [ -x "$CLIENT" ] && exec "$CLIENT" || echo "client not built" ;;
  test)   ctest --test-dir build --output-on-failure ;;
  *) echo "usage: hivemindctl {build|start|stop|restart|status|logs|client|test}"; exit 2 ;;
esac
