<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hub"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hub URL"
        android:labelFor="@id/urlEdit"
        android:textColor="@color/dim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/urlEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:textColor="@color/text"
        android:autofillHints="url" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="API key  (hive-server → /api/keys)"
        android:labelFor="@id/keyEdit"
        android:textColor="@color/dim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/keyEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textVisiblePassword"
        android:textColor="@color/text"
        android:autofillHints="password" />

    <CheckBox
        android:id="@+id/announceCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Announce agent state changes aloud (working, finished, errors)"
        android:textColor="@color/text" />

    <CheckBox
        android:id="@+id/notifyCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Read my notifications aloud (SMS, missed calls)"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/notifyAgentLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Also share them with agent:"
        android:textColor="@color/text" />

    <Spinner
        android:id="@+id/notifyAgentSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Test &amp; Save"
        android:textColor="@color/cyan" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/dim"
        android:textSize="13sp" />
</LinearLayout>
