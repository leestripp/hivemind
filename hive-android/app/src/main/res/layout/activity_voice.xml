<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hivemind.voice.SphereView
        android:id="@+id/sphereView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/agentAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="avatar" />

            <TextView
                android:id="@+id/agentNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Full chat panel (toggled by the bottom mode bar). Covers the
         sphere; own opaque background so the conversation is readable. -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:paddingTop="24dp"
        android:visibility="gone">

        <!-- Standard app bar: back arrow top-left (lee 2026-10-14:
             "back button with arrow at the top left like other Android
             apps" — replaces the bottom mode bar in chat). -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp">

            <ImageButton
                android:id="@+id/chatBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to voice"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:padding="12dp"
            android:paddingBottom="72dp"
            android:clipToPadding="false"
            android:stackFromBottom="true"
            android:transcriptMode="normal" />
    </LinearLayout>

    <!-- Fullscreen media overlay (image zoom / video player). Sits above
         the chat panel; an in-activity view has no window manager in the
         way (dialogs stayed floating top-third windows on this device). -->
    <FrameLayout
        android:id="@+id/mediaOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/buttonRow"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/btn_cancel"
            android:text="✕"
            android:textColor="#E85D75"
            android:textSize="20sp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/talkButton"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/btn_talk"
            android:text="TALK"
            android:textColor="@color/cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Chat opens to the RIGHT of TALK (lee 2026-10-14: fixed
             STOP–TALK–CHAT row so buttons never move around; cancelButton
             is INVISIBLE when idle so TALK stays dead-centre). -->
        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Text chat"
            android:src="@drawable/ic_chat" />
    </LinearLayout>
</FrameLayout>
