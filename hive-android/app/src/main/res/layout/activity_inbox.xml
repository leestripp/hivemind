<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inbox_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopSpeechButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/stop_reading"
            android:text="@string/stop_symbol"
            android:textColor="@color/cyan"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/inboxStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/loading_inbox"
        android:textColor="@color/dim"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/inboxList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
