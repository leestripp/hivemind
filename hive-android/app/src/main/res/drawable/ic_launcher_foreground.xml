<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground — Android port of the desktop
     org.hivemind.Client.svg (honey hexagon + agent-node network).
     108dp viewport; all key detail sits inside the 72dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
