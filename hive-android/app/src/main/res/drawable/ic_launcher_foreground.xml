                android:startX="54" android:startY="41.5"
                android:endX="54" android:endY="54.7">
                <item android:offset="0" android:color="#7C6BFF"/>
                <item android:offset="1" android:color="#4E3ECF"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M38.8,65.9 a4.6,4.6 0 1,1 9.2,0 a4.6,4.6 0 1,1 -9.2,0 Z"
