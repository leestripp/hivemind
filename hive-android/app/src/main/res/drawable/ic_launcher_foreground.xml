    <path android:pathData="M52,43.4 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0 Z"
        android:fillColor="#E6FFFFFF"/>
    <path android:pathData="M33.8,59.3 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0 Z"
