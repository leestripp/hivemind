    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Hexagon hive cell -->
    <path android:pathData="M54,17 L86,35.5 L86,72.5 L54,91 L22,72.5 L22,35.5 Z"
        android:strokeColor="#B87A00" android:strokeWidth="2.2">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="17"
                android:endX="86" android:endY="91">
                <item android:offset="0" android:color="#F7C14D"/>
                <item android:offset="1" android:color="#D4930D"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner honeycomb grid line -->
    <path android:pathData="M54,25 L79.1,39.5 L79.1,68.5 L54,83 L28.9,68.5 L28.9,39.5 Z"
