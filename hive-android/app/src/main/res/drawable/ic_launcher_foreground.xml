    <path android:pathData="M47.4,48.1 a6.6,6.6 0 1,1 13.2,0 a6.6,6.6 0 1,1 -13.2,0 Z"
        android:strokeColor="#FFFFFF" android:strokeWidth="1.3">
        <aapt:attr name="android:fillColor">
