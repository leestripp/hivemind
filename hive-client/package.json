{
  "name": "hivemind-client",
  "version": "0.1.0",
  "private": true,
  "description": "HiveMind desktop client \u2014 Electron, TypeScript, and accessible semantic HTML",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node scripts/start.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run build && node --test dist/tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "electron": "^39.2.3",
    "typescript": "^5.9.3"
  }
}
