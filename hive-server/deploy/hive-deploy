#!/bin/sh
# hive-deploy — pull latest main, rebuild, restart the service.
# Run as root ON the rig (dev-rig). From the dev box you can only do:
#   git push rig main
#   ssh hivemind@dev-rig 'cd ~/hivemind && git pull --ff-only && cmake --build build -j$(nproc)'
# root SSH is key-denied and the hivemind user has no sudo, so the final
# `systemctl restart hive-server` is done by the human on the rig.
set -e
runuser -u hivemind -- git -C /home/hivemind/hivemind pull --ff-only
runuser -u hivemind -- sh -c "cd /home/hivemind/hivemind && cmake --build build -j$(nproc)"
systemctl restart hive-server
sleep 2
systemctl is-active hive-server && curl -s http://127.0.0.1:8421/api/health
