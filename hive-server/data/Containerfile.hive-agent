# Containerfile.hive-agent — base image for HiveMind agent sandboxes.
# Built per machine on first use:  podman build -t localhost/hive-agent:latest \
#     -f hive-server/data/Containerfile.hive-agent .   (context = REPO ROOT)
#
# The agent runs as named user `hive` with passwordless sudo so it can
# install CLI tools mid-task (apt/pip/etc). Work happens in /workspace
# (the shared "company" volume); /home/hive is a per-agent bind mount.

ARG BASE=docker.io/library/ubuntu:26.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        sudo \
        git \
        curl \
        wget \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        pkg-config \
        jq \
        unzip \
        less \
        vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# Named agent user with passwordless sudo. HIVE_UID MUST equal the host
# user's uid: containers run with --userns=keep-id so the bind-mounted
# /workspace stays owned by (and writable by) BOTH the host user and the
# container's hive user. The base image's stock `ubuntu` user sits on
# uid 1000 — remove it so hive can take whatever uid the host needs.
ARG HIVE_UID=1000
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd -m -u ${HIVE_UID} -s /bin/bash hive \
    && echo "hive ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/hive \
    && chmod 0440 /etc/sudoers.d/hive

# Company workspace mount point (shared volume is mounted here at create).
RUN mkdir -p /workspace && chown hive:hive /workspace


# --- v2 (Phase B): the hive-agent binary -------------------------------
# The brain runs IN the image now. COPY the host-built binary and fix its
# ELF interpreter for ubuntu (host linkers may emit a different path);
# runtime libs for hive-brain (sqlite/openssl/zlib/png).
COPY build/hive-agent/hive-agent /usr/local/bin/hive-agent
RUN apt-get update && apt-get install -y --no-install-recommends \
        patchelf libsqlite3-0 libssl3t64 zlib1g libpng16-16t64 \
        libpoppler-cpp3 \
    && patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 \
                /usr/local/bin/hive-agent \
    && chmod 0755 /usr/local/bin/hive-agent \
    && rm -rf /var/lib/apt/lists/*

# --- Browser capability (Phase 68c): baked into BASE ------------------
# EVERY agent gets browser_* tools. The :browser variant used to carry
# this layer, but its pin was lost three times (2026-09-26/27/29), each
# time stranding browser-critical agents with "driver not installed".
# The stack starts ON DEMAND (browser_driver.py auto-runs hive-screen.sh
# on first use), so idle agents pay no RAM for it.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        openbox \
        novnc \
        websockify \
        fonts-dejavu-core \
        xfce4-terminal \
        xterm \
        htop \
        scrot \
    && rm -rf /var/lib/apt/lists/*

# Google Chrome STABLE (official .deb — real production browser; sites
# reject playwright's "Chromium for Testing" on sign-in flows).
RUN curl -sSL -o /tmp/chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update && apt-get install -y /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb && rm -rf /var/lib/apt/lists/*

# Playwright DRIVER (+ its chromium as last-resort fallback).
# ENV must precede the RUN or browsers land in /root/.cache.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN pip install --no-cache-dir --break-system-packages playwright \
    && playwright install chromium --with-deps \
    && chmod -R a+rX /opt/ms-playwright

COPY hive-server/data/hive-screen.sh /usr/local/bin/hive-screen.sh
COPY hive-server/data/hive-chrome.sh /usr/local/bin/hive-chrome.sh
RUN chmod +x /usr/local/bin/hive-screen.sh /usr/local/bin/hive-chrome.sh
COPY hive-server/data/openbox-menu.xml /etc/xdg/openbox/menu.xml
# Computer-use driver — /usr/local/bin, NOT /home/hive (the per-agent
# home bind mount would mask it).
COPY hive-server/data/browser_driver.py /usr/local/bin/browser_driver.py
RUN chmod 0755 /usr/local/bin/browser_driver.py

ENV DISPLAY=:99

USER hive
WORKDIR /workspace

# Sandbox idles until hive-server execs into it.
CMD ["sleep", "infinity"]
