# Containerfile.hive-agent-gpu — AMD GPU workhorse variant (Plan.md, 2026-09-01).
# FROM the browser variant so screen share keeps working on the GPU rig.
# Build chain on the rig:  :latest → :browser → :gpu
#   podman build -t localhost/hive-agent:gpu \
#       -f hive-server/data/Containerfile.hive-agent-gpu .   (context = repo root)
FROM localhost/hive-agent:browser

USER root

# GL + Vulkan (RADV) — viewport/Eevee tooling and general GPU compute.
RUN apt-get update && apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers libgl1-mesa-dri libegl-mesa0 libgbm1 \
        vulkan-tools mesa-utils gnupg \
    && rm -rf /var/lib/apt/lists/*

# ROCm HIP runtime for Blender Cycles. gfx1201 (RX 9070, RDNA4) is
# officially supported since ROCm 6.4.1 (matrix lists it in 10.0.0, 2026-08).
# AMD's apt repo tops out at 7.2.4 (latest/ -> 7.2.4, May 2026) and only
# has jammy/noble dists — noble HIP runtime libs run fine on resolute.
ARG ROCM_APT_VER=latest
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_APT_VER} noble main" \
        > /etc/apt/sources.list.d/rocm.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        rocm-hip-runtime rocminfo \
    && rm -rf /var/lib/apt/lists/*

# ROCm installs under /opt/rocm — expose it to the hive user.
ENV PATH="/opt/rocm/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/rocm/lib"

USER hive
WORKDIR /workspace
