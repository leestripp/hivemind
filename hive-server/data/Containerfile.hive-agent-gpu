# Containerfile.hive-agent-gpu — AMD GPU workhorse variant (Plan.md, 2026-09-01).
# FROM the browser variant so screen share keeps working on the GPU rig.
# Build chain on the rig:  :latest → :browser → :gpu
#   podman build -t localhost/hive-agent:gpu \
#       -f hive-server/data/Containerfile.hive-agent-gpu .   (context = repo root)
FROM localhost/hive-agent:browser

USER root

# GL + Vulkan (RADV) — viewport/Eevee tooling and general GPU compute.
RUN apt-get update && apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers libgl1-mesa-dri libegl-mesa0 libgbm1 \
        vulkan-tools mesa-utils gnupg \
    && rm -rf /var/lib/apt/lists/*

# ROCm HIP runtime for Blender Cycles — straight from the Ubuntu resolute
# archive (ROCm 7.1.1 in universe: libamdhip64-7 + rocminfo). gfx1201
# (RX 9070, RDNA4) is officially supported since ROCm 6.4.1, so 7.1.1
# covers it. No external repo, no key management.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libamdhip64-7 rocminfo \
    && rm -rf /var/lib/apt/lists/*

# Blender: official tarball, NOT the Ubuntu deb — Ubuntu's build compiles
# Cycles without HIP (verified 2026-09-01: repo blender rendered CPU-only;
# official tarball sees the RX 9070 XT as a HIP device). 5.1+ is REQUIRED
# by the official Blender MCP extension (blender_version_min = "5.1.0").
ARG BLENDER_VER=5.1.2
RUN curl -fsSL -o /tmp/blender.tar.xz \
        https://download.blender.org/release/Blender${BLENDER_VER%.*}/blender-${BLENDER_VER}-linux-x64.tar.xz \
    && tar -C /opt -xf /tmp/blender.tar.xz \
    && ln -s /opt/blender-${BLENDER_VER}-linux-x64/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz

# ── Official Blender MCP (projects.blender.org/lab/blender_mcp) ─────────
# Two halves from ONE repo snapshot so protocol versions always match:
# (1) the blender-mcp MCP bridge (stdio entry point; daedalus spawns it as
# a child of hive-agent), (2) the Blender 5.1 extension whose TCP socket
# server it relays to (localhost:9876; extension autostart pref defaults
# True once enabled). uv per the official tooling; baked at build time.
# NOTE: Gitea's /archive/ endpoint 403s for anonymous fetches — git clone
# (smart-http) works anonymously. Git is already in the :browser base.
RUN git clone --depth 1 https://projects.blender.org/lab/blender_mcp.git \
        /opt/blender-mcp-src \
    && rm -rf /opt/blender-mcp-src/.git \
    && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
       uv tool install /opt/blender-mcp-src/mcp

# Install the extension into a system extensions repo: the hive user's
# ~/.config is a per-agent mounted volume, so image-baked files must live
# outside it. BLENDER_SYSTEM_EXTENSIONS makes Blender scan this dir as the
# "system" repository on every launch (module name bl_ext.system.mcp).
ENV BLENDER_SYSTEM_EXTENSIONS=/opt/blender-extensions
# Layout is <dir>/<repo-id>/<pkg-id> — the "system" level is REQUIRED
# (verified: /opt/blender-extensions/mcp invisible, .../system/mcp works).
RUN mkdir -p /opt/blender-extensions/system \
    && cp -r /opt/blender-mcp-src/addon/blender_mcp_addon /opt/blender-extensions/system/mcp

# Blender's Wayland probe CRASHES when XDG_RUNTIME_DIR is unset (verified
# on 5.0.1: wl_display_connect segfault instead of graceful fallback) —
# give it a real dir so GHOST falls back to X11 (Xvfb) cleanly.
ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime-hive
RUN mkdir -p /tmp/xdg-runtime-hive && chmod 1777 /tmp/xdg-runtime-hive

# Auto-enable the extension on every Blender UI launch (deferred — see
# the script's comment for the 5.x _RestrictContext reason).
COPY hive-server/data/blender-mcp-autostart.py /tmp/blender-mcp-autostart.py
RUN mkdir -p /opt/blender-${BLENDER_VER}-linux-x64/${BLENDER_VER%.*}/scripts/startup \
    && cp /tmp/blender-mcp-autostart.py \
        /opt/blender-${BLENDER_VER}-linux-x64/${BLENDER_VER%.*}/scripts/startup/blender_mcp_autostart.py \
    && rm /tmp/blender-mcp-autostart.py

# NOTE: the MCP command queue is pumped by Blender's UI event loop —
# launch Blender ON THE XVFB DESKTOP (DISPLAY=:99 via hive-screen.sh, e.g.
# `blender &`), not `blender -b`, for interactive MCP control. Headless
# -b remains the right path for batch renders.

# Ubuntu packages land in standard paths (/usr/bin, /usr/lib/x86_64-linux-gnu)
# — no PATH/LD_LIBRARY_PATH fiddling needed.

USER hive
WORKDIR /workspace
