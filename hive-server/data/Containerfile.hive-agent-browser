# Containerfile.hive-agent-browser — computer-use variant (Phase 25: X11).
# Xvfb + x11vnc + noVNC/websockify + openbox (window manager) + playwright's
# chromium. Proven recipe — same stack as Anthropic's computer-use demo
# (they use mutter as the WM; openbox chosen here as the bulletproof
# container option — mutter's standalone X11 mode is gone in GNOME 50).
#
# Phase 24 tried GNOME-on-Wayland (mutter --headless + gnome-remote-desktop
# VNC) — blocked: GRD dropped clients pre-greeting. Trail: docs/computer-use.md.
#
# Build:  podman build -t localhost/hive-agent:browser \
#             -f hive-server/data/Containerfile.hive-agent-browser hive-server/data

FROM localhost/hive-agent:latest

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        openbox \
        novnc \
        websockify \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Chromium: Ubuntu's chromium-browser deb is a snap stub (snaps can't run
# in containers). Playwright's bundled chromium is the real browser — PyPI
# wheel (the Ubuntu python3-playwright deb strips the node driver).
# Browsers in a shared world-readable path: build runs as root, agents run
# as hive. ENV must precede the RUN or chromium lands in /root/.cache.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN pip install --no-cache-dir --break-system-packages playwright \
    && playwright install chromium --with-deps \
    && chmod -R a+rX /opt/ms-playwright

COPY hive-screen.sh /usr/local/bin/hive-screen.sh
RUN chmod +x /usr/local/bin/hive-screen.sh

USER hive
WORKDIR /workspace

# Xvfb :99, x11vnc :5900 (password-protected), noVNC/websockify :6080.
# Stack starts on demand via hive-screen.sh (container_exec).
ENV DISPLAY=:99
EXPOSE 6080
CMD ["sleep", "infinity"]
